      "parameters": {
        "promptType": "define",
        "text": "=You are an expert technical recruiter. Read the following raw Job Description text and extract the core requirements into a strict JSON format.\n\nYou must extract exactly these 5 sections:\n\n\"experience\": Years and type of experience required.\n\n\"education\": Degrees or academic background required.\n\n\"technical_skills\": Specific software, languages, or tools required.\n\n\"qualifications\": Certifications or soft skills required.\n\n\"projects\": Any specific portfolio items or project types required.\n\nReturn ONLY valid JSON. Do not include markdown formatting or conversational text.\n\nRaw Job Description:\n{{ $json.jd_text }}",
        "batching": {}
