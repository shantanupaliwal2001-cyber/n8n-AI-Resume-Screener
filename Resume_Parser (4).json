    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert technical recruiter. Read the following raw candidate resume text and extract their background into a strict JSON format.\n\nYou must extract exactly these 5 sections based on the resume provided:\n\n\"experience\": The candidate's work history and years of experience.\n\n\"education\": Degrees or academic background.\n\n\"technical_skills\": Specific software, languages, or tools they know.\n\n\"qualifications\": Certifications or soft skills mentioned.\n\n\"projects\": Any specific portfolio items or projects listed.\n\nReturn ONLY valid JSON. Do not include markdown formatting or conversational text.\n\nRaw Resume:\n{{ $json.resume_text }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1920,
        -48
      ],
      "id": "feefe3d6-e90c-4bef-9033-f67f3b2d3d3f",
      "name": "Extract Resume JSON",
      "executeOnce": false,
      "retryOnFail": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "let rawText = $input.first().json.text || \"\";\nlet cleanText = rawText.replace(/```json/gi, \"\").replace(/```/gi, \"\").trim();\n\ntry {\n    let parsed = JSON.parse(cleanText);\n    return [{ json: { ...parsed, extraction_status: \"OK\" } }];\n} catch (error) {\n    return [{\n        json: {\n            experience: {}, education: {}, technical_skills: {}, qualifications: {},\n            projects: {},\n            extraction_status: \"EXTRACTION_FAILED\",\n            extraction_reason: \"UNPARSEABLE_LIKELY_TRUNCATED\"\n        }\n    }];\n}"
      },
      "type": "n8n-nodes-base.code",
