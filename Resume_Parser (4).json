    {
      "parameters": {
        "jsCode": "// 1. Get the raw text from the Grader LLM\nlet rawText = $input.first().json.text;\n\n// 1a. Check if the LLM call itself failed (no output at all)\nif (rawText === undefined) {\n    return [{\n        json: {\n            score: null,\n            verdict: \"MANUAL_REVIEW\",\n            reason: \"LLM_CALL_FAILED\",\n            summary: \"\",\n            full_grading: { fitment_score: 0 }\n        }\n    }];\n}\n\n// 2. Strip the markdown backticks\nlet cleanText = rawText.replace(/```json/gi, \"\").replace(/```/gi, \"\").trim();\n\nlet graderResult;\ntry {\n    graderResult = JSON.parse(cleanText);\n} catch (error) {\n    // 2a. The LLM responded, but its output wasn't valid JSON\n    return [{\n        json: {\n            score: null,\n            verdict: \"MANUAL_REVIEW\",\n            reason: \"UNPARSEABLE_OUTPUT\",\n            summary: \"\",\n            full_grading: { fitment_score: 0 }\n        }\n    }];\n}\n\n// 3. Generate the Verdict\nlet score = graderResult.fitment_score || 0;\nlet verdict = \"Weak Fit\";\n\nif (score >= 75) {\n    verdict = \"Strong Fit\";\n} else if (score >= 50) {\n    verdict = \"Potential Fit\";\n}\n\n// 4. Output a perfectly clean package for Google Sheets\nreturn [{\n    json: {\n        score: score,\n        verdict: verdict,\n        reason: \"GRADED\",\n        summary: graderResult.summary || \"\",\n        full_grading: graderResult\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3072,
        -96
