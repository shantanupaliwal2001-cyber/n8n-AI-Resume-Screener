    {
      "parameters": {
        "jsCode": "let rawText = $input.first().json.text || \"\";\n\n// Strip the annoying markdown backticks that the LLM hallucinates\nlet cleanText = rawText.replace(/```json/gi, \"\").replace(/```/gi, \"\").trim();\n\ntry {\n    // Convert the clean string into a real JSON object\n    let parsedData = JSON.parse(cleanText);\n    return [ { json: parsedData } ];\n} catch (error) {\n    // If the LLM completely fails, output an empty structure so the loop doesn't crash\n    return [ { \n        json: { \n            \"experience\": {}, \n            \"education\": {}, \n            \"technical_skills\": {}, \n            \"qualifications\": {}, \n            \"projects\": {} \n        } \n    } ];\n}"
      },
      "type": "n8n-nodes-base.code",
