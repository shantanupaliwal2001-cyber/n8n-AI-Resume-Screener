    {
      "parameters": {
        "jsCode": "// 1. Get the raw text from the Grader LLM\nlet rawText = $input.first().json.text || \"\";\n\n// 2. Strip the markdown backticks\nlet cleanText = rawText.replace(/```json/gi, \"\").replace(/```/gi, \"\").trim();\n\nlet graderResult;\ntry {\n    graderResult = JSON.parse(cleanText);\n} catch (error) {\n    graderResult = { fitment_score: 0, summary: \"Error parsing LLM grading.\" };\n}\n\n// 3. Generate the Verdict\nlet score = graderResult.fitment_score || 0;\nlet verdict = \"Weak Fit\";\n\nif (score >= 75) {\n    verdict = \"Strong Fit\";\n} else if (score >= 50) {\n    verdict = \"Potential Fit\";\n}\n\n// 4. Output a perfectly clean package for Google Sheets\nreturn [{\n    json: {\n        score: score,\n        verdict: verdict,\n        summary: graderResult.summary || \"\",\n        full_grading: graderResult\n    }\n}];"
      },
